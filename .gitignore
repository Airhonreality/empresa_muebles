# ── PROJECT LAYER — never lives in the seed ──────────────────────────────────
# These directories belong to project forks. The seed has them empty (.gitkeep).
# Merging upstream/main into a project fork will NEVER touch these paths.

# In a project fork, all storage/ is yours to commit freely.
storage/*
!storage/.gitkeep
!storage/AGENTS.md
!storage/definition-revision.json
# Capas de personalización del fork (se versionan y deployan)
!storage/styles/
!storage/styles/**
!storage/site-injections.json
!storage/head.html
!storage/body-end.html
!storage/progreso/
!storage/progreso/**
# backups del CLI agno / ciclo gobernado: locales, no se versionan
storage/progreso/backups/
!storage/fork_doc/
!storage/fork_doc/**
!storage/docs/
!storage/docs/**

# Project-specific custom blocks built with AI
# Exception: _TEMPLATE.tsx is part of the seed (shows the pattern to follow)
src/components/specialized/*
!src/components/specialized/_TEMPLATE.tsx
!src/components/specialized/DataBrowser.tsx
!src/components/specialized/calendar-scheduler/
!src/components/specialized/calendar-scheduler/**



# local Claude Code settings (machine-specific, never committed)
.claude/

.vercel
.env*.local
/.history/
.codex/
