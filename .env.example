# ── DATOS ────────────────────────────────────────────────────────────────
# La estrategia explícita evita inferencias accidentales.
# local ignora DATABASE_URL; postgres la requiere.
# El ciclo de definiciones se declara por separado: legacy, shadow o revision.
# local | github | postgres | supabase
AGNOSTIC_STORAGE_STRATEGY=local
# legacy | shadow | revision
AGNOSTIC_DEFINITION_MODE=legacy
# Snapshot exportado requerido por el build en modo revision
AGNOSTIC_DEFINITION_SNAPSHOT=
# Revision inmutable esperada por build y runtime
AGNOSTIC_DEFINITION_REVISION=
DATABASE_URL=
GITHUB_TOKEN=
GITHUB_REPO=usuario/repositorio
GITHUB_BRANCH=main
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── ARCHIVOS ─────────────────────────────────────────────────────────────
# Cloudflare R2 guarda assets, imágenes y adjuntos.
CF_ACCOUNT_ID=
CF_R2_BUCKET=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_URL=

# ── APLICACIÓN ───────────────────────────────────────────────────────────
# Secreto de sesión, llave de CLI y URL pública del frontend.
SESSION_SECRET=
API_SECRET_KEY=
NEXT_PUBLIC_BASE_URL=

# ── DESPLIEGUE ───────────────────────────────────────────────────────────
# Vercel y Netlify son los proveedores soportados por el seed.
# PRODUCTION_URL se conserva como alias legado para scripts CLI.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
PRODUCTION_URL=

# ── METADATOS DE PROVEEDOR ───────────────────────────────────────────────
# El CLI y la UI intentan inferir este correo desde la API del proveedor cuando hay permisos.
# Si la API no lo expone, el dato debe quedar registrado manualmente.
VERCEL_ACCOUNT_EMAIL=
NETLIFY_ACCOUNT_EMAIL=
GITHUB_ACCOUNT_EMAIL=
DATABASE_ACCOUNT_EMAIL=
CF_ACCOUNT_EMAIL=
SUPABASE_ACCOUNT_EMAIL=

# ── ADAPTERS OPCIONALES ──────────────────────────────────────────────────
# Cada adapter instalado puede aportar su propio fragmento de variables y ejemplos.

# ── Route protection (OPCIONAL — override de deploy) ──
# La forma preferida y versionada es editar `agnostic.routing.ts` (fork-owned).
# El engine ya protege /schema, /_data, /api/admin, /api/engine, /api/pulse, /api/vault.
# Estas env vars SUMAN a lo de agnostic.routing.ts; útiles solo para un override
# puntual en un deploy sin recompilar. Prefijos separados por comas.
# AGNOSTIC_PROTECTED_PATHS=
# AGNOSTIC_PROTECTED_API_PATHS=
# AGNOSTIC_PUBLIC_PATHS=
# AGNOSTIC_PUBLIC_SHARE_PATHS=
