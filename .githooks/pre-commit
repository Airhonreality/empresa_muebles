#!/bin/sh
# Agnostic Seed - pre-commit hook
# Validates storage/ JSON and text encoding before every commit, and (in forks)
# guards the engine/fork ownership boundary.
# Installed automatically by: npm install (via "prepare" script in package.json)
set -e
node scripts/validate-storage.mjs
node scripts/validate-text-encoding.mjs
# Fork-only: warns (or blocks with AGNOSTIC_GUARD_STRICT=1) on engine edits. No-op in the seed.
node scripts/guard-engine-edits.mjs
